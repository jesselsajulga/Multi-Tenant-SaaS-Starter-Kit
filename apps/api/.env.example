# ==============================================================================
# Multi-Tenant SaaS Starter Kit - API Environment Configuration
# ==============================================================================

# Database
# PostgreSQL connection string with public schema
DATABASE_URL="postgresql://postgres:password@localhost:5432/saas_starter?schema=public"

# Application / CORS
# Base URL for the frontend application (used for CORS and redirect URLs)
FRONTEND_URL="http://localhost:3000"

# Stripe Billing & Subscriptions
# Secret key obtained from the Stripe developer dashboard (test or live)
STRIPE_SECRET_KEY="sk_test_..."
# Webhook signing secret (from `stripe listen` or webhook dashboard)
STRIPE_WEBHOOK_SECRET="whsec_..."
# (Optional) Stripe Price ID for Pro tier checkout
STRIPE_PRICE_PRO="price_..."

# Google OAuth / Single Sign-On (SSO)
# OAuth client ID from Google Cloud Console
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# OAuth client secret from Google Cloud Console
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# Callback redirect URI registered in Google Cloud Console
GOOGLE_REDIRECT_URI="http://localhost:4000/auth/sso/google/callback"
